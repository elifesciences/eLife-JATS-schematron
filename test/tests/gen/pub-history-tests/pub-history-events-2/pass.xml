    <front>
      <article-meta>
        <pub-history>
          <event>
            <self-uri content-type="preprint"/>
          </event>
        </pub-history>
        <custom-meta-group>
          <custom-meta specific-use="meta-only">
            <meta-name>publishing-route</meta-name>
            <meta-value>prc</meta-value>
          </custom-meta>
        </custom-meta-group>
      </article-meta>
    </front>
  </article>
</root>